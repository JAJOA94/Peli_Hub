# Copiá este archivo a `.env` y completá los valores reales.
# El archivo `.env` NO se sube a Git (está en .gitignore).

# Generá una clave secreta con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-real

# En desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECURE_SSL_REDIRECT=False

# Conexión opcional a Supabase/PostgreSQL.
# Si se deja vacío o se omite, el proyecto usa SQLite local.
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@db.TU_PROYECTO.supabase.co:5432/postgres
