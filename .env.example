# Copiá este archivo a `.env` y completá los valores reales.
# El archivo `.env` NO se sube a Git (está en .gitignore).

# Generá una clave secreta con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-real

# En producción poné False
DJANGO_DEBUG=False

# Dominios permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Forzar redirección a HTTPS (True recomendado en producción)
DJANGO_SECURE_SSL_REDIRECT=True
